# ============================================================
# ThrottleGate — single consolidated environment file
# Used by: docker-compose.yml and local (non-Docker) runs of
# throttle-gate. Keep all env vars here; do not create
# per-directory .env files.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=throttlegate
POSTGRES_PASSWORD=TestPostgresPass123!
SPRING_DATASOURCE_USERNAME=throttlegate
SPRING_DATASOURCE_PASSWORD=TestPostgresPass123!

# --- Redis ---
REDIS_PASSWORD=TestRedisPass123!
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=TestRedisPass123!

# --- Spring Boot runtime ---
SPRING_CLOUD_CONFIG_ENABLED=false

# --- ThrottleGate ---
THROTTLEGATE_RESILIENCE_MODE=fail-open
THROTTLEGATE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- ThrottleGate admin credentials ---
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=TestAdminPass123!
