# ThrottleGate — environment variables template
# Copy this file to .env (project root) and fill in the values.
# This is the ONLY env file the project uses.

# --- PostgreSQL ---
POSTGRES_USER=throttlegate
POSTGRES_PASSWORD=

# --- Spring datasource (local non-Docker runs) ---
SPRING_DATASOURCE_USERNAME=throttlegate
SPRING_DATASOURCE_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# --- Spring Boot runtime ---
SPRING_CLOUD_CONFIG_ENABLED=false

# --- ThrottleGate ---
THROTTLEGATE_RESILIENCE_MODE=fail-open
THROTTLEGATE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- ThrottleGate admin credentials ---
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=
